# =============================================================================
# research_work — .gitignore (branch: feature/data)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Python & environment
# -----------------------------------------------------------------------------
.env
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
pyproject.toml
uv.lock


# -----------------------------------------------------------------------------
# 2. OS & IDE
# -----------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp


# -----------------------------------------------------------------------------
# 3. Jupyter
# -----------------------------------------------------------------------------
notebooks/
.ipynb_checkpoints/


# -----------------------------------------------------------------------------
# 4. Datasets  (see datasets/README.md)
# -----------------------------------------------------------------------------
#
# Tracked (committed):
#   datasets/README.md
#   datasets/train_samples/*.parquet   (500×3 + combined_raw 1,500)
#   datasets/eval_samples/*.parquet    (200×4 + gaia 165)
#
# Ignored (rebuild locally):
#   datasets/raw/, processed/, cache/, golden/, complexity/, gaia_attachments/

# Default: ignore everything under datasets/
datasets/**

# Exceptions — sample parquets + docs
# !datasets/README.md
# !datasets/train_samples/
# !datasets/train_samples/**
# !datasets/eval_samples/
# !datasets/eval_samples/**

# Large / cache paths (explicit; also covered by datasets/**)
datasets/raw/**
datasets/
datasets/processed/**
datasets/cache/**
datasets/golden/**
datasets/complexity/**
datasets/gaia_attachments/**
old/** 
images/
!datasets/decomposer_cache
# -----------------------------------------------------------------------------
# 5. Scripts
# -----------------------------------------------------------------------------
#
# Tracked: data pipeline only
# Ignored:  run_agents_shared_config.py, test_*.py, etc.

scripts/*

!scripts/create_eval_samples.py
!scripts/create_train_samples.py
!scripts/download.py
!scripts/inspect_training_data.py
!scripts/normalize_math_data.py


# -----------------------------------------------------------------------------
# 6. Tests — track refactor safety net; ignore local scratch
# -----------------------------------------------------------------------------
tests/__pycache__/
tests/.pytest_cache/
test.py
test_router.py
test_tools.py
test_tools_smoke.py



# -----------------------------------------------------------------------------
# 7. Experiments, results & outputs
# -----------------------------------------------------------------------------
agents/
baselines/
complexity/
data/*
final_results/
logs/
outputs/*.csv
outputs/*.png
results/
results_v1/
results_v2/
results1/


# -----------------------------------------------------------------------------
# 8. Application code — local WIP (not on feature/data)
# -----------------------------------------------------------------------------
dashboard.py
run.py
vanallia.py
.vanallia.py

# Obsolete path (replaced by src/data/)
src/loaders/download_gia_attachments.py
